{
  "FrameRate": 60,
  "CanvasWidth": 320,
  "CanvasHeight": 200,
  "Fusion2": {
    "Headers": [
      // Mapped with "identify lights" on 2026-11-04.
      // LedCount 0 keeps a header off. Find the real count with "identify walk fusion2 <header>".
      { "Header": "D_LED1", "Name": "Rear fan (Corsair RS120)", "LedCount": 8, "ColorOrder": "Auto" },
      { "Header": "D_LED2", "Name": "Front fans (3x Vetroo SA-140, parallel)", "LedCount": 12, "ColorOrder": "Auto" },
      { "Header": "D_LED3", "Name": "Bottom fans (3x, parallel)", "LedCount": 8, "ColorOrder": "Auto" },
      { "Header": "D_LED4", "Name": "Unused (nothing connected)", "LedCount": 0, "ColorOrder": "Auto" }
    ],
    // Board LEDs: firmware zone 2 lights the bottom of the board (walk onboard --all-zones, 2026-11-04).
    "OnboardZones": [ 2 ]
  },
  "Layout": [
    // Canvas is the case viewed from the side window: x 0 = front, 1 = rear; y 0 = top, 1 = bottom.
    { "Device": "fusion2", "Zone": "D_LED1", "Shape": "Ring", "X": 0.92, "Y": 0.22, "Radius": 0.06 },
    // D_LED2: the 3 front fans are wired in parallel and mirror one 12-LED ring; sample at the middle fan.
    { "Device": "fusion2", "Zone": "D_LED2", "Shape": "Ring", "X": 0.07, "Y": 0.5, "Radius": 0.07 },
    // D_LED3: the 3 bottom fans are wired in parallel and mirror one 8-LED ring; sample at the middle fan.
    { "Device": "fusion2", "Zone": "D_LED3", "Shape": "Ring", "X": 0.52, "Y": 0.92, "Radius": 0.07 },
    { "Device": "fusion2", "Zone": "onboard", "Shape": "Line", "X": 0.4, "Y": 0.75, "X2": 0.75, "Y2": 0.75 },
    // LINK: ch1 TITAN outer ring around the cooler, ch2 LCD cap inner ring, ch13-15 top radiator fans.
    { "Device": "link", "Zone": "ch1", "Shape": "Ring", "X": 0.55, "Y": 0.38, "Radius": 0.06 },
    { "Device": "link", "Zone": "ch2", "Shape": "Ring", "X": 0.55, "Y": 0.38, "Radius": 0.035 },
    { "Device": "link", "Zone": "ch13", "Shape": "Ring", "X": 0.3, "Y": 0.07, "Radius": 0.07 },
    { "Device": "link", "Zone": "ch14", "Shape": "Ring", "X": 0.52, "Y": 0.07, "Radius": 0.07 },
    { "Device": "link", "Zone": "ch15", "Shape": "Ring", "X": 0.74, "Y": 0.07, "Radius": 0.07 },
    // GPU (RTX 5070 Ti Gaming OC): one LED zone on the side facing the window.
    { "Device": "gpu", "Zone": "z0", "Shape": "Line", "X": 0.4, "Y": 0.56, "X2": 0.75, "Y2": 0.56 },
    // Mouse and keyboard sit outside the case; they sample the lower front corner of the canvas.
    { "Device": "mouse", "Zone": "z0", "Shape": "Line", "X": 0.05, "Y": 0.95, "X2": 0.05, "Y2": 0.95 },
    { "Device": "mouse", "Zone": "z1", "Shape": "Line", "X": 0.1, "Y": 0.95, "X2": 0.1, "Y2": 0.95 },
    { "Device": "keyboard", "Zone": "keys", "Shape": "Grid", "X": 0.15, "Y": 0.82, "X2": 0.85, "Y2": 0.98 }
  ]
}
